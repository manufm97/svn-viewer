{
  "name": "svn-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Visor de repositorios SVN con interfaz estilo GitLab",
  "license": "MIT",
  "main": "electron/main.js",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node scripts/dev.js",
    "vite": "vite",
    "build": "vite build",
    "start": "electron .",
    "smoke": "vite build && node scripts/smoke.js",
    "dist": "vite build && powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "dist:nsis": "vite build && electron-builder --win nsis",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "productName": "SVN Viewer",
    "appId": "com.personal.svnviewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SVN Viewer"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@material-design-icons/font": "^0.14.15",
    "@vitejs/plugin-vue": "^6.0.10",
    "diff": "^9.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2",
    "highlight.js": "^11.12.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
